---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Chance B. Ronemus — geologist. Assistant Professor, Department of Earth, Energy & Environment, University of Calgary. Sedimentology, tectonics, geochronology, and stable isotope geochemistry.',
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/join/', label: 'Join the Group' },
  { href: '/research-projects/', label: 'Research' },
  { href: '/cv/', label: 'CV' },
  { href: '/research/', label: 'Publications' },
  { href: '/teaching/', label: 'Research Group' },
  { href: '/media/', label: 'Media' },
  { href: '/photography/', label: 'Photography' },
  { href: '/climbing/', label: 'Climbing' },
];

const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/media/2025/04/site-icon.png" />
    <link rel="apple-touch-icon" href="/media/2025/04/site-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    {/* Privacy-friendly analytics (GoatCounter): no cookies, no personal
        data, so no consent banner needed. Production builds only. */}
    {import.meta.env.PROD && (
      <script
        is:inline
        async
        data-goatcounter="https://YOUR_GOATCOUNTER_CODE.goatcounter.com/count"
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="site-title" href="/">Chance B. Ronemus</a>
        <nav class="site-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div>
          <h2>Chance B. Ronemus</h2>
          <p class="tagline">
            Rocks — Climbing them, studying them, and shooting them with
            lasers until they tell me their secrets
          </p>
        </div>
        <div>
          <address>
            <a href="mailto:chance.ronemus@ucalgary.ca">chance.ronemus@ucalgary.ca</a><br />
            <a
              href="https://www.google.com/maps/search/Department+of+Earth,+Energy+%26+Environment,+University+of+Calgary,+2500+University+Drive+NW,+Calgary,+AB,+T2N+1N4+Canada"
              target="_blank"
              rel="noopener noreferrer"
            >
              Department of Earth, Energy &amp; Environment<br />
              University of Calgary<br />
              2500 University Drive NW<br />
              Calgary, AB T2N 1N4, Canada
            </a>
          </address>
        </div>
        <p class="fineprint">
          © {new Date().getFullYear()} Chance B. Ronemus. All uncredited
          photos are my own — please ask if you'd like to use one.
        </p>
      </div>
    </footer>
  </body>
</html>
